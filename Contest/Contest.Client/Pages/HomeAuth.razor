@page "/homeauth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveAuto

<PageTitle>Auth</PageTitle>
<AuthorizeView Roles="Student">
    <h1>Hello Student</h1>
</AuthorizeView>
<AuthorizeView Roles="Teacher">
    <h1> Hello Teacher</h1>
</AuthorizeView>
<AuthorizeView Roles="Admin">
    <ul>
        <li><a href="/accounttypelisting">Account Types</a></li>
        <li><a href="/secretquestionlisting">Secret Questions</a></li>
        <li><a href="/tutorialListing">Tutorials</a></li>
    </ul>
</AuthorizeView>
