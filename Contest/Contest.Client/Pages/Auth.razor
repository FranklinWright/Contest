@page "/auth"

@using Microsoft.AspNetCore.Authorization

@attribute [Authorize]
@rendermode InteractiveAuto

<PageTitle>Auth</PageTitle>
<i class="bi bi-apple"></i>
<h1>You are authenticated</h1>

<AuthorizeView Roles="Teacher">
    Hello @context.User.Identity?.Name!

    <br /><br />

    <h3>Roles</h3>
    Is in role "Admin": @context.User.IsInRole("Admin")<br />
    Is in role "Teacher": @context.User.IsInRole("Teacher")<br />
    Is in role "Student": @context.User.IsInRole("Student")<br />
    <br />

    <h3>Claims</h3>

    @foreach (var claim in context.User.Claims)
    {
        <dt>@claim.Type</dt>
        <dd>@claim.Value</dd>
    }
</AuthorizeView>
