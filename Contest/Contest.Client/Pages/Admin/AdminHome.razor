@page "/admin/home"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Home - Admin</PageTitle>
<Header />
<AuthorizeView>
    <h1>
        Welcome, @context.User.Claims.FirstOrDefault(c => c.Type == "FirstName")?.Value!
    </h1>
</AuthorizeView>
<p>
    Tutorials R Us is a great tool for selecting helpful tutorials for your students. Each tuturial includes multiple lessons followed by a quiz. You can easily monitor each
    student's progress as they complete the assigned tutorials.
</p>
<h3>Getting Started</h3>
<ul>
    <li>Click the <b>Tutorials</b> button to create and edit the tutorials.</li>
    <li>Click the <b>Secret Questions</b> button to create and edit the secret questions used to reset the password.</li>
    <li>Click the <b>Weather</b> button to view the local weather forecast.</li>
</ul>

