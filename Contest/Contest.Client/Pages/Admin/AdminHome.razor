@page "/admin/home"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Home - Admin</PageTitle>
<Header />
<p>
    Tutorials R Us is a great tool for selecting helpful tutorials for your students. Each tuturial includes multiple lessons followed by a quiz. You can easily monitor each
    student's progress as they complete the assigned tutorials.
</p>
<h3>Getting Started</h3>
<ul>
    <li>Click the <b>Classes</b> button to create and edit the list of classes you are teaching. After you have created a class you can use the <i>Class Code</i> to invite students to the class.</li>
    <li>Click the <b>Students</b> button to view the list of students in each of your classes.</li>
    <li>Click the <b>Weather</b> button to view the local weather forecast.</li>
</ul>
