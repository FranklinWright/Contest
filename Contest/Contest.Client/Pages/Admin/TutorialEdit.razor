@page "/tutorialedit/{tutorialId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Tutorial Edit</PageTitle>
<Header />

@if (tutorialId == 0)
{
    <h1>Add Tutorial</h1>
}
else
{
    <h1>Edit Tutorial</h1>
}

@if (tutorial == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="main">
        <EditForm Model="tutorial" OnValidSubmit="OnValidSubmit">
            <div class="mb-2">Id: @tutorial.TutorialId</div>
            <div class="mb-2">
                <label>Tutorial Name</label>
                <div>
                    <InputText class="form-control" @bind-Value="tutorial.Title" />
                    <ValidationMessage For="@(() => tutorial.Title)" />
                </div>
            </div>

            <div class="mb-2">
                <label for="tutorial.Description">Description</label>
                <textarea class="form-control" @bind="tutorial.Description" rows="3"></textarea>
                <ValidationMessage For="@(() => tutorial.Description)" />
            </div>

            <div class="mb-2">
                <label for="tutorial.Tags">Tags</label>
                <InputText class="form-control" @bind-Value="tutorial.Tags" />
                <ValidationMessage For="@(() => tutorial.Tags)" />
            </div>
            <DataAnnotationsValidator />         
        

        <br />
        <button type="submit" class="btn btn-success mr-auto"><i class="bi bi-save" title="Save tutorial"></i> Save</button>
        
        <button type="button" class="btn btn-secondary mr-auto" @onclick="EditCancel" title="Cancel"><i class="bi bi-x-square"></i></button>
        @if (tutorial.TutorialId > 0)
        {
            <span> | </span>
            <button type="button" class="btn btn-danger mr-auto" @onclick="Delete" title="Delete tutorial"><i class="bi bi-trash-fill"></i></button>
        }
        </EditForm>
        @if (tutorial.TutorialId > 0)
        {
           <hr />

            <h2>
                Lessons
                <a href="lessonedit/@tutorial.TutorialId/0"><button class="btn btn-success" title="Add lesson"><i class="bi bi-plus-circle"></i></button></a>
            </h2>
            @if (lesson == null || quiz == null)
            {
                <p><em>Loading...</em></p>
            }
            else
            {
                @if (lesson.Count == 0)
                {
                    <p><em>No Lessons found.</em></p>
                }
                else
                {
                    <p><em>Lessons found: @lesson.Count </em></p>

                    <ul>
                        @foreach (var lesson in lesson)
                        {
                            <div class="pb-2">
                                <a class="btn btn-primary" href="lessonedit/@tutorial.TutorialId/@lesson.LessonId" title="View lesson"><i class="bi bi-pencil-fill"></i></a>
                                <span class="b-2 ps-1"> @lesson.Title</span>
                            </div>
                        }
                    </ul>
                }
                <hr />
                <h2>
                    Quiz Questions
                    <a href="quizedit/@tutorial.TutorialId/0"><button class="btn btn-success" title="Add quiz"><i class="bi bi-plus-circle"></i></button></a>
                </h2>
                @if (quiz.Count == 0)
                {
                    <p><em>No Questions found.</em></p>
                }
                else
                {
                    <p><em>Questions found: @quiz.Count</em></p>

                    <ul>
                        @foreach (var quiz in quiz)
                        {
                            <div class="pb-2">
                                <a class="btn btn-sm btn-primary" href="quizedit/@tutorial.TutorialId/@quiz.QuizId"><i class="bi bi-pencil-fill"></i></a>
                                <span class="b-2"> @quiz.Topic</span>
                            </div>
                        }
                    </ul>
                }
            }
        }
    </div>


    <br />
    @if (ShowErrorMsg)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error!</h4>
            <p>@ErrorMessages["Message"]</p>
        </div>
    }
}

@code {
    [Parameter] public int tutorialId { get; set; }

    private TutorialResponse? tutorial = new TutorialResponse();
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    protected override async Task OnParametersSetAsync()
    {
        if (tutorialId > 0)
        {
            var service = new TutorialService(navManager);

            try
            {
                tutorial = await service.GetTutorialAsync(tutorialId);
            }
            catch (Exception ex)
            {
                ErrorMessages["Message"] = ex.Message;
                ShowErrorMsg = true;
            }
        }
    }

    protected async Task OnValidSubmit()
    {
        var service = new TutorialService(navManager);
        if (tutorial!.TutorialId == 0)
        {
            var newTutorial = new Tutorial
            {
                Title = tutorial.Title,
                Description = tutorial.Description,
                Tags = tutorial.Tags
            };
            var success = await service.CreateTutorialAsync(newTutorial);
            if (!success)
            {
                ErrorMessages["Message"] = "Error creating tutorial.";
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("tutoriallisting");
            }
        }
        else
        {
            var updatedTutorial = new Tutorial
            {
                TutorialId = tutorial.TutorialId,
                Title = tutorial.Title,
                Description = tutorial.Description,
                Tags = tutorial.Tags
            };
            var success = await service.UpdateTutorialAsync(updatedTutorial);
            if (!success)
            {
                ErrorMessages["Message"] = "Error updating tutorial.";
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("tutoriallisting");
            }
        }
    }

    private void EditCancel()
    {
        navManager.NavigateTo("tutoriallisting");
    }

    private async void Delete()
    {
        var service = new TutorialService(navManager);
        await service.DeleteTutorialAsync(tutorial!.TutorialId);
        navManager.NavigateTo("tutoriallisting");
    }

    private async void Save()
    {
        
    }

    private List<Lesson>? lesson;
    private List<Quiz>? quiz;

    protected override async Task OnInitializedAsync()
    {
        var service = new LessonService(navManager);
        lesson = await service.GetLessonAsyncInOrder(tutorialId);
        var service2 = new QuizService(navManager);
        quiz = await service2.GetQuizAsyncInOrder(tutorialId);
    }





}
