@page "/tutoriallisting"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Tutorials</PageTitle>
<Header />

<h1>
    Tutorials
    <a href="tutorialedit\0"><button class="btn btn-success"><i class="bi bi-plus-circle"></i></button></a>
</h1>

@if (tutorials == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-1 mt-2">
        <input type="text" @bind="SearchString" placeholder="Search" /> <button class="btn btn-primary" @onclick="Search"><i class="bi bi-search"></i></button>
    </div>

    @if (tutorials.Count == 0)
    {
        <p><em>No tutorials found.</em></p>
    }
    else
    {
        <p><em>Tutorials found: @tutorials.Count</em></p>
        <ul class="list-group">
            @foreach (var tutorial in tutorials)
            {
                <li class="list-group-item">
                    <a class="btn btn-primary" href="tutorialedit\@tutorial.TutorialId" title="Edit tutorial"><i class="bi bi-pencil-fill"></i></a>
                    <label class="form-check-label ps-2" for="@tutorial.TutorialId">
                        <b>@tutorial.Title</b>                     
                    </label>
                    <div class="pt-2">@tutorial.Description</div>
                </li>
            }
        </ul>
    }
}

@code {
    private List<TutorialResponse>? tutorials;
    private string? SearchString { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();
    }

    protected async Task Search()
    {
        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();
        if (!string.IsNullOrEmpty(SearchString))
        {
            tutorials = tutorials!.Where(s => s.Tags.Contains(SearchString)).ToList();
        }
    }
}


