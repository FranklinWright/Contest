@page "/tutoriallisting"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Tutorials</PageTitle>
<Header />
@* <nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="adminmenu">Admin Menu</a></li>
        <li class="breadcrumb-item active">Tutorial Listing</li>
    </ol>
</nav> *@

<h3>
    Tutorial Listing
    <a href="tutorialedit\0"><button class="btn btn-sm btn-success"><i class="bi bi-plus-circle"></i></button></a>
</h3>

@if (tutorials == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-1 mt-2">
        <input type="text" @bind="SearchString" placeholder="Search" /> <button class="btn btn-sm btn-primary" @onclick="Search"><i class="bi bi-search"></i></button>
    </div>

    @if (tutorials.Count == 0)
    {
        <p><em>No Tutorials found.</em></p>
    }
    else
    {
        <p><em>Found @tutorials.Count Tutorials.</em></p>

        <ul>
            @foreach (var tutorial in tutorials)
            {
                <div class="pb-2">
                    <a class="btn btn-sm btn-primary" href="tutorialedit\@tutorial.TutorialId"><i class="bi bi-pencil-fill"></i></a>
                    <span class="b-2"> @tutorial.Title</span>
                </div>
            }
        </ul>
    }
}

@code {
    private List<Tutorial>? tutorials;
    private string? SearchString { get; set; }

    protected override async Task OnInitializedAsync()
    {
        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();
    }

    protected async Task Search()
    {
        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();
        if (!string.IsNullOrEmpty(SearchString))
        {
            tutorials = tutorials!.Where(s => s.Tags.Contains(SearchString)).ToList();
        }
    }
}


