@page "/secretquestionlisting"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Secret Questions</PageTitle>

<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="adminmenu">Admin Menu</a></li>
        <li class="breadcrumb-item active">Secret Question Listing</li>
    </ol>
</nav>

<h3>
    Secret Question Listing
    <a href="secretquestionedit\0"><button class="btn btn-sm btn-success">+</button></a>
</h3>

@if (secretQuestions == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (secretQuestions.Count == 0)
    {
        <p><em>No secret questions found.</em></p>
    }
    else
    {
        <p><em>Found @secretQuestions.Count secret questions.</em></p>

        @foreach (var question in secretQuestions)
        {
            <div class="pb-2">
            <a class="btn btn-sm btn-primary" href="secretquestionedit\@question.SecretQuestionId">Edit</a>
            <span class="b-2"> @question.Question</span>
            </div>
        }
    }
}

@code {
    private List<SecretQuestion>? secretQuestions;

    protected override async Task OnInitializedAsync()
    {
        var service = new SecretQuestionsService(navManager);
        secretQuestions = await service.GetSecretQuestionsAsync();
    }
}
