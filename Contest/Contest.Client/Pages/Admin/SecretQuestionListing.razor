@page "/secretquestionlisting"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Secret Questions</PageTitle>
<Header />

<h1>
    Secret Questions
    <a href="secretquestionedit\0"><button class="btn btn-success" title="Add secret question"><i class="bi bi-plus-circle"></i></button></a>
</h1>

@if (secretQuestions == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (secretQuestions.Count == 0)
    {
        <p><em>No secret questions found.</em></p>
    }
    else
    {
        <p><em>Secret questions found: @secretQuestions.Count.</em></p>

        @foreach (var question in secretQuestions)
        {
            <div class="pb-2">
                <a class="btn btn-primary" href="secretquestionedit\@question.SecretQuestionId" title="Edit secret question"><i class="bi bi-pencil-fill"></i></a>
                <span class="b-2 ps-1"> @question.Question</span>
            </div>
        }
    }
}

@code {
    private List<SecretQuestion>? secretQuestions;

    protected override async Task OnInitializedAsync()
    {
        var service = new SecretQuestionsService(navManager);
        secretQuestions = await service.GetSecretQuestionsAsync();
    }
}
