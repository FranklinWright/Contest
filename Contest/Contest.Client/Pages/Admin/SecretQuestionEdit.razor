@page "/secretquestionedit/{secretQuestionId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Account Types</PageTitle>
<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="adminmenu">Admin Menu</a></li>
        <li class="breadcrumb-item"><a href="secretquestionlisting">Secret Question Listing</a></li>
        <li class="breadcrumb-item active">Edit</li>
    </ol>
</nav>
<h3>Secret Question Edit</h3>

@if (question == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="main">
        <EditForm Model="question" OnValidSubmit="OnValidSubmit">
            <div>Id: @question.SecretQuestionId</div>
            <div class="form-group">
                <label>Question</label>
                <div>
                    <InputText class="form-control" @bind-Value="question.Question" />
                    <ValidationMessage For="@(() => question.Question)" />
                </div>
            </div>

            <DataAnnotationsValidator />
           
            <br />
            <button type="submit" class="btn btn-primary mr-auto">Save</button>
            <button type="button" class="btn btn-secondary mr-auto" @onclick="EditCancel">Cancel</button>
        </EditForm>
    </div>

    <br />
    @if (ShowErrorMsg)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error!</h4>
            <p>@ErrorMessages["Message"]</p>
        </div>
    }
}

@code {
    [Parameter] public int secretQuestionId { get; set; }

    private SecretQuestion? question = new SecretQuestion();
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    protected override async Task OnParametersSetAsync()
    {
        if (secretQuestionId > 0)
        {
            var service = new SecretQuestionsService(navManager);

            try 
            {
                question = await service.GetSecretQuestionAsync(secretQuestionId);
            }
            catch (Exception ex)
            {
                ErrorMessages["Message"] = ex.Message;
                ShowErrorMsg = true;
            }
        }  
    }

    protected async Task OnValidSubmit()
    {
        var service = new SecretQuestionsService(navManager);
        if (question!.SecretQuestionId == 0)
        {
            var result = await service.CreateSecretQuestionAsync(question!);
            if (result == null)
            {
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("secretquestionlisting");
            }
        }
        else
        {
            var result = await service.UpdateSecretQuestionAsync(question!);
            if (result == null)
            {
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("secretquestionlisting");
            }
        }
    }

    private void EditCancel()
    {
        navManager.NavigateTo("secretquestionlisting");
    }
}
