@page "/teacher/home"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<Header />

<p>
    Tutorials R Us is a great tool for selecting helpful tutorials for your students. Each tuturial includes multiple lessons followed by a quiz. 
</p>
<h3>Getting Started</h3>
<ul>
    <li>Click the <b>Tutorials</b> button to create and edit the tutorials.</li>
    <li>Click the <b>Secret Questions</b> button to create and edit the secret questions used to reset the password.</li>
    <li>Click the <b>Weather</b> button to view the local weather forecast.</li>
</ul>

