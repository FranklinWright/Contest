@page "/teacher/home"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
<PageTitle>Home</PageTitle>
<Header />
<AuthorizeView>
    <h1>
        Welcome, @context.User.Claims.FirstOrDefault(c => c.Type == "FirstName")?.Value!
    </h1>
</AuthorizeView>
<p>
    Tutorials R Us is a great tool for selecting helpful tutorials for your students. Each tuturial includes multiple lessons followed by a quiz. 
</p>
<h3>Getting Started</h3>
<ul>
    <li>Click the <b>Classes</b> button to create and edit the list of classes you are teaching. After you have created a class you can use the <i>Class Code</i> to invite students to the class.</li>
    <li>Click the <b>Tutorials</b> button to associate tutorials with classes.</li>
    <li>Click the <b>Students</b> button to view the list of students in each of your classes.</li>
</ul>

