@page "/teacher/class-edit/{classId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
@using Microsoft.AspNetCore.Authorization

<PageTitle>Class Edit</PageTitle>
<Header />

<h3>Class Edit </h3>

@if (classes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="main">
        <EditForm Model="classes" OnValidSubmit="OnValidSubmit">
            <div>Id: @classes.ClassId</div>
            <div class="form-group">
                <label>Class Name</label>
                <div>
                    <InputText class="form-control" @bind-Value="classes.ClassName" />
                    <ValidationMessage For="@(() => classes.ClassName)" />
                </div>
            </div>

            <div class="form-group">
                <label>Class Code</label>
                <div>
                    <InputText class="form-control" @bind-Value="classes.ClassCode" />
                    <ValidationMessage For="@(() => classes.ClassCode)" />
                </div>
            </div>

            <DataAnnotationsValidator />

            <br />
            <button type="submit" class="btn btn-primary mr-auto" title="Save"><i class="bi bi-save"></i></button>
            <button type="button" class="btn btn-secondary mr-auto" title="Cancel" @onclick="EditCancel"><i class="bi bi-x-square"></i></button>
            @if (classes.ClassId > 0)
            {
                <span> | </span>
                <button type="button" class="btn btn-danger mr-auto" title="Delete" @onclick="Delete"><i class="bi bi-trash-fill"></i></button>
            }
        </EditForm>
        <hr />
        @if (tutorials == null)
        {
            <p><em>Loading...</em></p>
        }
        else
        {
            <h3>
                Tutorials
                <a href="teacher/tutorial-add"><button class="btn btn-sm btn-success"><i class="bi bi-plus-circle"></i></button></a>
            </h3> @if (tutorials.Count == 0)
            {
                <p><em>No Tutorials found.</em></p>
            }
            else
            {
                <p><em>Tutorials Found:@tutorials.Count</em></p>

                <ul>
                    @foreach (var tutorial in tutorials)
                    {
                        <div class="pb-2">
                            <a class="btn btn-sm btn-primary" href="teacher/tutorial-edit/@tutorial.TutorialId"><i class="bi bi-pencil-fill"></i></a>
                            <span class="b-2"> @tutorial.Tutorial!.Title</span>
                        </div>
                    }
                </ul>
            }
        }
    </div>

    <br />
    @if (ShowErrorMsg)
    {
        <div class="alert alert-danger" role="alert">
            <h4 class="alert-heading">Error!</h4>
            <p>@ErrorMessages["Message"]</p>
        </div>
    }
}

@code {
    [Parameter] public int classId { get; set; }

    private Class? classes = new Class();
    private List<ClassTutorialResponse>? tutorials;
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    protected override async Task OnParametersSetAsync()
    {
        if (classId > 0)
        {
            try
            {
                var service = new ClassService(navManager);
                classes = await service.GetClassAsync(classId);

                var classTutorialService = new ClassTutorialService(navManager);
                tutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);
            }
            catch (Exception ex)
            {
                ErrorMessages["Message"] = ex.Message;
                ShowErrorMsg = true;
            }
        }
    }

    protected async Task OnValidSubmit()
    {
        var service = new ClassService(navManager);
        if (classes!.ClassId == 0)
        {

            var success = await service.CreateClassAsync(classes!);
            if (!success)
            {
                ErrorMessages["Message"] = "Error creating new class.";
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("classlisting");
            }
        }
        else
        {
            var success = await service.UpdateClassAsync(classes!);
            if (!success)
            {
                ErrorMessages["Message"] = "Error updating class.";
                ShowErrorMsg = true;
            }
            else
            {
                navManager.NavigateTo("classlisting");
            }
        }
    }

    private void EditCancel()
    {
        navManager.NavigateTo("classlisting");
    }

    private async void Delete()
    {
        var service = new ClassService(navManager);
        await service.DeleteClassAsync(classes!.ClassId);
        navManager.NavigateTo("classlisting");
    }
}
