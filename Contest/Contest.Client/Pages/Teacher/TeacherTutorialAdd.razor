@page "/teacher/tutorial-add/{classId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Tutorials</PageTitle>
<Header />

<h1>
    Tutorials
</h1>

@if (!ShowTutorials)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="mb-1 mt-2">
        <input type="text" @bind="SearchString" placeholder="Search" /> <button class="btn btn-primary" @onclick="Search"><i class="bi bi-search"></i></button>
    </div>

    @if (tutorials.Count == 0)
    {
        <p><em>No Tutorials found.</em></p>
    }
    else
    {
        <p><em>Tutorials Found: @tutorials.Count</em></p>

        <h4>
            Select Tutorials to Add
        </h4>
        <div style="color:gray" class="pb-1">(Note: Only tutorials that are not already in the class are listed.)</div>
        <ul class="list-group">
            @foreach (var tutorial in tutorials)
            {
                <li class="list-group-item">
                    <input class="form-check-input me-1" type="checkbox" id="@tutorial.TutorialId" @onchange="() => CheckboxChanged(tutorial.TutorialId)">
                    <label class="form-check-label" for="@tutorial.TutorialId">
                        <b>@tutorial.Title</b>
                        <div>@tutorial.Description</div>
                    </label>
                </li>
            }
        </ul>
        <br />
        <button class="btn btn-primary" @onclick="SaveSelectedTutorials" title="Add selected tutorials to class"><i class="bi bi-save"></i> Add Tutorials</button>
    }
}

@code {
    [Parameter] public int classId { get; set; }

    private bool ShowTutorials = false;
    private List<TutorialResponse>? tutorials;
    private string? SearchString { get; set; }
    private List<ClassTutorialResponse>? classTutorials;
    private List<int> newTutorials = new List<int>();

    protected override async Task OnInitializedAsync()
    {
        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();

        var classTutorialService = new ClassTutorialService(navManager);
        classTutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);

        // Remove tutorials that are already added to the class
        foreach (var classTutorial in classTutorials)
        {
            tutorials.Remove(tutorials.FirstOrDefault(t => t.TutorialId == classTutorial.TutorialId));
        }

        ShowTutorials = true;
    }

    protected async Task Search()
    {
        ShowTutorials = false;

        var service = new TutorialService(navManager);
        tutorials = await service.GetTutorialAsync();
        if (!string.IsNullOrEmpty(SearchString))
        {
            tutorials = tutorials!.Where(s => s.Tags!.Contains(SearchString)).ToList();
        }

        // Remove tutorials that are already added to the class
        foreach (var classTutorial in classTutorials)
        {
            tutorials.Remove(tutorials.FirstOrDefault(t => t.TutorialId == classTutorial.TutorialId));
        }

        ShowTutorials = true;
    }

    private void CheckboxChanged(int tutorialId)
    {
        if (newTutorials.Contains(tutorialId))
        {
            newTutorials.Remove(tutorialId);
        }
        else
        {
            newTutorials.Add(tutorialId);
        }
    }

    private async Task SaveSelectedTutorials()
    {
        var classTutorialService = new ClassTutorialService(navManager);
        foreach (var item in newTutorials)
        {
            await classTutorialService.CreateClassTutorialAsync(new ClassTutorial { ClassId = classId, TutorialId = item });
        }

        navManager.NavigateTo($"teacher/tutorial-listing/{classId}");
    }
}


