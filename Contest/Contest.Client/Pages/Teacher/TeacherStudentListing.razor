@page "/teacher/student-listing"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<Header />
<h3>Student Listing</h3>
This is a list of students by class.
<br />

@if (classes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (classes.Count == 0)
    {
        <p><em>No Classes found.</em></p>
    }
    else
    {
        // make a dropdown list of classes
        <select class="form-select" aria-label="Default select example" @onchange="SelectClass">
            <option selected value="0">Select a class</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassId">@item.ClassName</option>
            }
        </select>
    }
}

@if (ShowStudents){
    <br />
    <h3>Students</h3>
    @if (students == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (students.Count == 0)
        {
            <p><em>No Students found.</em></p>
        }
        else
        {
            <p><em>Students found: @students.Count</em></p>

            <ul>
                @foreach (var item in students)
                {
                    <div class="pb-2">
                        <span class="b-2"> @item</span>
                    </div>
                }
            </ul>
        }
    }
}

@code {
    private List<Class>? classes;
    private bool ShowStudents = false;
    private List<string>? students;

    protected override async Task OnInitializedAsync()
    {
        var service = new ClassService(navManager);
        classes = await service.GetClassAsync();
    }

    protected async Task SelectClass(ChangeEventArgs e)
    {
        if (e.Value.ToString() == "0")
        {
            ShowStudents = false;
            return;
        }

        students = new List<string>();
        ShowStudents = true;
        List<ClassUserResponse> result;
        var service = new ClassUserService(navManager);
        result = await service.GetClassUserByClassIdAsync(int.Parse(e.Value.ToString()));
    }
}
