@page "/teacher/student-listing"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Students</PageTitle>
<Header />

<h1>Students By Class</h1>

@if (classes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (classes.Count == 0)
    {
        <p><em>No classes found.</em></p>
    }
    else
    {
        // make a dropdown list of classes
        <select class="form-select" aria-label="Default select example" @onchange="SelectClass">
            <option selected value="0">Select a class</option>
            @foreach (var item in classes)
            {
                <option value="@item.ClassId">@item.ClassName</option>
            }
        </select>
    }
}

@if (ShowStudents)
{
    <br />
    <h2>Students</h2>
    @if (students == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (students.Count == 0)
        {
            <p><em>No Students found.</em></p>
        }
        else
        {
            <p><em>Students found: @studentProgresses.Count</em></p>

            @foreach (var item in studentProgresses)
            {
                <h3><span class="b-2"> @item.Key</span></h3>
                <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Title</th>
                                <th>Percent Done</th>
                                <th>Quiz Score</th>
                            </tr>
                        </thead>
                         <tbody>

                @foreach (var pro in item.Value.ToList())
                {
                    <tr>
                <td>@pro.Title</td>
                <td>
                    <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                        <div class="progress-bar" style="width: @pro.PercentageDone%"></div>
                                    </div>
                    @pro.PercentageDone%</td>
                                <td>
                                    @if (pro.QuizGrade == null)
                                    {

                                    }
                                    else
                                    {
                                        <span>@pro.QuizGrade%</span>
                                    }
                                </td>
                </tr>
                }
                        </tbody>
                    </table>
                
            }
           
        }
    }
}

@code {
    private List<Class>? classes;
    private bool ShowStudents = false;
    private List<ClassUserResponse>? classesUsers;
    private List<ClassTutorialResponse>? classTutorials;
    private int classId = 0;
    private List<Student> students;
    private Dictionary<string, List<StudentProgress>> studentProgresses = new Dictionary<string, List<StudentProgress>>();

    protected override async Task OnInitializedAsync()
    {
        var service = new ClassService(navManager);
        classes = await service.GetClassAsync();
    }

    protected async Task SelectClass(ChangeEventArgs e)
    {
        classId = int.Parse(e.Value.ToString());
        if (classId == 0)
        {
            ShowStudents = false;
            return;
        }

        // Get the tutorials in the class
        var classTutorialService = new ClassTutorialService(navManager);
        classTutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);

        // Get the students in the class
        var classUserService = new ClassUserService(navManager);
        classesUsers = await classUserService.GetClassUserByClassIdAsync(classId);

        if (classesUsers == null)
        {
            return;
        };
        students = classesUsers[0].Students;

        foreach (var student in students)
        {
            var studentName = student.FirstName;

            var studentTutorialService = new StudentTutorialService(navManager);
            var studentTutorials = await studentTutorialService.GetStudentTutorialByStudentIdAsync(student.UserId);

            var progresses = new List<StudentProgress>();
            foreach (var studentTutorial in studentTutorials)
            {
                var curTutorial = classTutorials.Where(q => q.TutorialId == studentTutorial.TutorialId).FirstOrDefault();
                if (curTutorial == null) { continue; };
                int nextLesson = studentTutorial.CompletedLessons + 1;
                if (nextLesson > curTutorial.LessonCount)
                {
                    nextLesson = curTutorial.LessonCount;
                }

                var newStudentProgress = new StudentProgress
                    {
                        TutorialId = curTutorial.TutorialId,
                        Title = curTutorial.Tutorial!.Title!,
                        LessonCount = curTutorial.LessonCount,
                        NextLesson = nextLesson,
                        PercentageDone = ((studentTutorial!.CompletedLessons * 100) / curTutorial.LessonCount),
                        QuizGrade = studentTutorial.QuizScore
                    };

                progresses.Add(newStudentProgress);
            }

            // Add the unstarted tutorials
            foreach (var assigned in classTutorials)
            {
                var started = progresses.Where(q => q.TutorialId == assigned.TutorialId).FirstOrDefault();
                if (started == null)
                {
                    var newStudentProgress = new StudentProgress
                        {
                            TutorialId = assigned.TutorialId,
                            Title = assigned.Tutorial.Title,
                            LessonCount = 0,
                            NextLesson = 1,
                            PercentageDone = 0,
                            QuizGrade = null
                        };

                    progresses.Add(newStudentProgress);
                }
            }

            studentProgresses.Add(studentName, progresses);
        };


        ShowStudents = true;
    }


    public class StudentProgress
    {
        public int TutorialId { get; set; }
        public string? Title { get; set; }
        public int LessonCount { get; set; }
        public int NextLesson { get; set; }
        public int PercentageDone { get; set; }
        public int? QuizGrade { get; set; }
        public string? Action { get; set; }
    }


}
