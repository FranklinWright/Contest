@page "/teacher/tutorial-listing"
@page "/teacher/tutorial-listing/{Id:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<Header />
<h3>Tutorials By Class</h3>

@if (classes == null)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (classes.Count == 0)
    {
        <p><em>No Classes found.</em></p>
    }
    else
    {
        <select class="form-select" aria-label="Default select example" @onchange="SelectClass">
            <option selected value="0">Select a class</option>
            @foreach (var item in classes)
            {
                if (item.ClassId == classId)
                {
                    <option value="@item.ClassId" selected>@item.ClassName</option>
                }
                else{
                    <option value="@item.ClassId">@item.ClassName</option>
                }
            }
        </select>
    }
}

@if (ShowTutorials)
{
    <br />
    <h3>Tutorials
        <a href="teacher/tutorial-add/@classId"><button class="btn btn-sm btn-success"><i class="bi bi-plus-circle"></i></button></a>
    </h3>
    @if (tutorials == null)
    {
        <p><em>Loading...</em></p>
    }
    else
    {
        @if (tutorials.Count == 0)
        {
            <p><em>No Tutorials found.</em></p>
        }
        else
        {
            <p><em>Tutorials Found: @tutorials.Count</em></p>
           
            <ul class="list-group">
                @foreach (var tutorial in tutorials)
                {
                    <li class="list-group-item">
                        <button type="button" class="btn btn-danger align-top" @onclick="() => DeleteTutorial(tutorial.ClassTutorialId)" title="Delete"><i class="bi bi-trash-fill"></i></button>
                        <label class="form-check-label ps-2" for="@tutorial.TutorialId">
                            <b>@tutorial.Tutorial.Title</b>
                            <div>@tutorial.Tutorial.Description</div>
                        </label>
                    </li>
                }
            </ul>
        }
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private List<Class>? classes;
    private bool ShowTutorials = false;
    private List<ClassTutorialResponse>? tutorials;
    private int classId = 0;

    protected override async Task OnInitializedAsync()
    {
        classId = Id;
        var service = new ClassService(navManager);
        classes = await service.GetClassAsync();

        if (classId > 0)
        {
            await DisplayTutorials();
        };
    }

    protected async Task SelectClass(ChangeEventArgs e)
    {
        classId = int.Parse(e.Value.ToString());

        if (classId == 0)
        {
            ShowTutorials = false;
            return;
        }

        await DisplayTutorials();
    }

    private async Task DisplayTutorials()
    {
        tutorials = new List<ClassTutorialResponse>();
        ShowTutorials = true;

        var classTutorialService = new ClassTutorialService(navManager);
        tutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);
    }

    private async Task DeleteTutorial(int classTuturialId)
    {
        if (classTuturialId > 0)
        {
            var classTutorialService = new ClassTutorialService(navManager);
            await classTutorialService.DeleteClassTutorialAsync(classTuturialId);
            navManager.NavigateTo("/teacher/tutorial-listing", true);
        }
    } 
}
