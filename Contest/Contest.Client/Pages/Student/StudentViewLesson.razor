@page "/student/tutorial/{tutorialId:int}/{lessonPlace:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
@using Microsoft.AspNetCore.Authorization

<PageTitle>Lessons</PageTitle>
<Header />

@if(lesson == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div style="color:navy">@tutorial!.Title</div>
    <h1>@lesson[lessonPlace-1].Title</h1>
    @((MarkupString)lesson[lessonPlace-1].Body)
    <hr />
    @if(lessonPlace > 0)
    {
        <button type="button" class="btn btn-danger mr-auto" @onclick="Back" title="Previous Page"><i class="bi bi-arrow-left"></i> Previous</button>
    }
    else
    {
        <button type="button" class="btn btn-light mr-auto" disabled  title="Previous Page"><i class="bi bi-arrow-left"></i> Previous</button>
    }
    <span class="ps-2 pe-2">Lesson @lessonPlace of @tutorial.LessonCount</span>
    @if (lessonPlace < tutorial!.LessonCount)
    {
        <button type="button" class="btn btn-success mr-auto" @onclick="Next" title="Next Page">Next <i class="bi bi-arrow-right"></i></button>
    }
    else
    {
        <button type="button" class="btn btn-light mr-auto" disabled title="Next Page">Next <i class="bi bi-arrow-right"></i></button>
    }
    @if (lessonPlace == tutorial!.LessonCount)
    {
        <hr />
        <h3>Quiz Time</h3>
        <div>This is the last lesson. Click the <b>Start Quiz</b> button when you are ready to take the quiz.</div>
        <br />
        <button type="button" class="btn btn-primary mr-auto" @onclick="Quiz" title="Start Quiz"><i class="bi bi-clipboard-x"></i> Start Quiz</button>
    }

}

@code {
    [Parameter] public int tutorialId { get; set; }
    [Parameter] public int lessonPlace { get; set; }
    private List<Lesson>? lesson;
    private TutorialResponse? tutorial;

    protected override async Task OnParametersSetAsync()
    {
        var lessonService = new LessonService(navManager);
        lesson = await lessonService.GetLessonAsyncInOrder(tutorialId);
        var tutorialService = new TutorialService(navManager);
        tutorial = await tutorialService.GetTutorialAsync(tutorialId);
    }

    private async void Next()
    {
        UpdateProgress();
        navManager.NavigateTo("/student/tutorial/" + tutorialId + "/" + (lessonPlace + 1));
    }

    private async void Back()
    {
        navManager.NavigateTo("/student/tutorial/" + tutorialId + "/" + (lessonPlace - 1));
    }

    private async void Quiz()
    {
        UpdateProgress();
        navManager.NavigateTo("/student/quiz/" + tutorialId);
    }

    private async void UpdateProgress()
    {
        var studentService = new StudentTutorialService(navManager);
        var studentsProgress = await studentService.GetStudentTutorialByTutorialIdAsync(tutorialId);
        var progress = studentsProgress.FirstOrDefault();

        if (lessonPlace >= progress!.CompletedLessons)
        {
            progress!.CompletedLessons = lessonPlace;
            var success = await studentService.UpdateStudentTutorialAsync(progress!);
        }
    }
}
