@page "/student/quiz/{tutorialId:int}/{lessonPlace:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
@using Microsoft.AspNetCore.Authorization

<Header />

<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="student/classlisting">Classes</a></li>
        <li class="breadcrumb-item active">Class</li>
    </ol>
</nav>



@if (lesson == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@tutorial.Title's Quiz</h1>
    
    <div class="form-check">
    <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios1" @bind="selectedOption">
    <label class="form-check-label" for="exampleRadios1">
        Default radio
    </label>
</div>
<div class="form-check">
    <input class="form-check-input" type="radio" name="exampleRadios" id="exampleRadios2" @bind="selectedOption">
    <label class="form-check-label" for="exampleRadios2">
        Second default radio
    </label>
</div>

<button @onclick="CaptureSelection">Capture Selection</button>

<br />
    <h1>@SaveselectedOption</h1>


   

}


@code {
    [Parameter] public int tutorialId { get; set; }
    [Parameter] public int lessonPlace { get; set; }
    private List<Lesson>? lesson;
    private TutorialResponse? tutorial;
    private List<StudentTutorial>? students;
    private StudentTutorial? student;
    private string selectedOption;
    private string SaveselectedOption;

    protected override async Task OnParametersSetAsync()
    {

        var service = new LessonService(navManager);
        lesson = await service.GetLessonAsyncInOrder(tutorialId);
        var service2 = new TutorialService(navManager);
        tutorial = await service2.GetTutorialAsync(tutorialId);
        var service3 = new StudentTutorialService(navManager);
        students = await service3.GetStudentTutorialAsync();
        bool check = true;
        if (students != null)
        {

            foreach (StudentTutorial st in students)
            {
                if (st.TutorialId == tutorialId)
                {
                    student = st;
                    check = false;
                    break;
                }
            }

        }
        if (check)
        {
            student = new StudentTutorial();
            student.TutorialId = tutorialId;
            var success = service3.CreateStudentTutorialAsync(student);
        }

    }

    private void CaptureSelection()
    {
        // Use the selectedOption variable to access the selected radio button value
        Console.WriteLine($"Selected option: {selectedOption}");

        // You can perform further actions with the selected value here
    }


}
