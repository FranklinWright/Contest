@page "/student/home"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<Header />
<p>Tutorials R Us is a great tool for taking tutorials. Each tuturial includes multiple lessons followed by a quiz. </p>

<ul>
    <li>Click the <b>Classes</b> button to create and edit the list of classes you are taking. You will need a <i>Class Code</i> to take a class.</li>
    <li>Click the <b>Weather</b> button to view the local weather forecast.</li>
</ul>