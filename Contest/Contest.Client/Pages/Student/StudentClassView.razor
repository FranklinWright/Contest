@page "/student/class/{classId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
@using Microsoft.AspNetCore.Authorization


 <nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="student/classlisting">Classes</a></li>
        <li class="breadcrumb-item active">Class</li>
    </ol>
</nav>

@if (classes == null || tutorials == null || studentTutorials == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1><u>@classes.ClassName Class</u></h1>
    <br />
    
    @if (tutorials.Count == 0)
    {
        <p><em>No Tutorials found.</em></p>
    }
    else
    {

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Tutorial Name</th>
                    <th>Percentage Done</th>
                    <th>Quiz Grade</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var tutorial in tutorials)
                {
                    var matchingStudentTutorial = studentTutorials.FirstOrDefault(st => st.TutorialId == tutorial.TutorialId);
                    if (matchingStudentTutorial != null)
                    {
                        int precent = ((matchingStudentTutorial.CompletedLessons +1) * 100 / (tutorial.LessonCount+1));
                        <tr>

                            <td>@tutorial.Title</td>
                            <td>@precent%</td>
                            <td>@matchingStudentTutorial.QuizScore%</td>
                            <td><a class="btn btn-sm btn-primary" href="/student/tutorial/@tutorial.TutorialId/@matchingStudentTutorial.CompletedLessons"><i class="bi bi-eye"></i></a></td>
                        </tr>
                    }
                    else
                    {
                        <tr>
                    <td>@tutorial.Title</td>
                    <td>0%</td>
                    <td>0%</td>
                    <td><a class="btn btn-sm btn-primary" href="/student/tutorial/@tutorial.TutorialId/0"><i class="bi bi-eye"></i></a></td>
                    </tr>
                    }
                }
            </tbody>
        </table>




         


       
    }
    



}

@code {
    [Parameter] public int classId { get; set; }

    private Class? classes = new Class();
    private List<TutorialResponse>? tutorials;
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    private List<StudentTutorial>? studentTutorials;
    private List<TutorialResponse>? tutorialStuff;

    protected override async Task OnParametersSetAsync()
    {
        if (classId > 0)
        {
            try
            {
                var service = new ClassService(navManager);
                classes = await service.GetClassAsync(classId);

                var classTutorialService = new ClassTutorialService(navManager);
                var tutorialsClass = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);
                tutorials = new List<TutorialResponse>();

                var service4 = new TutorialService(navManager);
                tutorialStuff = await service4.GetTutorialAsync();
                if(tutorialsClass != null && tutorialStuff != null)
                {
                    foreach (ClassTutorialResponse tutorial in tutorialsClass)
                    {
                        foreach(TutorialResponse tutorialResponse in tutorialStuff)
                        {
                            if (tutorial.TutorialId.Equals(tutorialResponse.TutorialId))
                            {
                                tutorials.Add(tutorialResponse);
                            }
                        }
                    }
                }

                var studentTutorialService = new StudentTutorialService(navManager);
                studentTutorials = await studentTutorialService.GetStudentTutorialAsync();

                


            }
            catch (Exception ex)
            {
                ErrorMessages["Message"] = ex.Message;
                ShowErrorMsg = true;
            }
        }
    }

}
