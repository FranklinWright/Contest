@page "/student/class/{classId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager
@using Microsoft.AspNetCore.Authorization


 <nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="student/classlisting">Classes</a></li>
        <li class="breadcrumb-item active">Class</li>
    </ol>
</nav>

@if (classes == null || tutorials == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1><u>@classes.ClassName Class</u></h1>
    <br />
    
    @if (tutorials.Count == 0)
    {
        <p><em>No Tutorials found.</em></p>
    }
    else
    {
        <p><em>Tutorials Found: @tutorials.Count </em></p>

        <ul>
            @foreach (var tutorial in tutorials)
            {
                if (tutorial.Tutorial != null)
                {
                    <div class="pb-2">
                        <a class="btn btn-sm btn-primary" href="home"><i class="bi bi-eye"></i></a>
                        <span class="b-2"> @tutorial.Tutorial.Title: has completed 5% of it. Score Received ... </span>
                    </div>
                }
            }
        </ul>
    }
    



}

@code {
    [Parameter] public int classId { get; set; }

    private Class? classes = new Class();
    private List<ClassTutorialResponse>? tutorials;
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    protected override async Task OnParametersSetAsync()
    {
        if (classId > 0)
        {
            try
            {
                var service = new ClassService(navManager);
                classes = await service.GetClassAsync(classId);

                var classTutorialService = new ClassTutorialService(navManager);
                tutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);
            }
            catch (Exception ex)
            {
                ErrorMessages["Message"] = ex.Message;
                ShowErrorMsg = true;
            }
        }
    }

}
