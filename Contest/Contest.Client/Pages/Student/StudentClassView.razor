@page "/student/class/{classId:int}"

@using Contest.Client.Services
@rendermode InteractiveAuto
@inject NavigationManager navManager

<PageTitle>Class</PageTitle>
<Header />

<nav>
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="student/classlisting">Classes</a></li>
        <li class="breadcrumb-item active">Class</li>
    </ol>
</nav>

@if (!ShowData)
{
    <p><em>Loading...</em></p>
}
else
{
    <h1>@curClass.ClassName</h1>

    @if (classTutorials.Count == 0)
    {
        <p><em>No tutorials found.</em></p>
    }
    else
    {

        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Tutorial Name</th>
                    <th>Percentage Done</th>
                    <th>Quiz Grade</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var progress in studentProgresses)
                {
                    <tr>
                        <td>@progress.Title</td>
                        <td>
                            <div class="progress" role="progressbar" aria-label="Basic example" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar" style="width: @progress.PercentageDone%"></div>
                            </div>
                            @progress.PercentageDone%
                        </td>
                        <td>@progress.QuizGrade</td>
                        <td>
                            @if (progress.QuizGrade == null)
                            {
                                <a class="btn btn-success" href="/student/tutorial/@progress.TutorialId/@progress.NextLesson" title="Start @progress.Title">View Tutorial</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    [Parameter] public int classId { get; set; }
    private bool ShowData = false;
    private Class? curClass;
    private List<ClassTutorialResponse>? classTutorials;
    protected bool ShowErrorMsg = false;
    protected Dictionary<string, string> ErrorMessages = new Dictionary<string, string>();

    private List<StudentTutorial>? studentTutorials;
    private List<StudentProgress> studentProgresses = new List<StudentProgress>();

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            // Get the class.
            var classService = new ClassService(navManager);
            curClass = await classService.GetClassAsync(classId);

            // Get the tutorials for the class.
            var classTutorialService = new ClassTutorialService(navManager);
            classTutorials = await classTutorialService.GetClassTutorialsByClassIdAsync(classId);

            if (classTutorials != null)
            {
                // Get the student tutorials for each of the tutorials.
                var studentTutorialService = new StudentTutorialService(navManager);
                List<StudentTutorial>? studentTutorials = new List<StudentTutorial>();
                foreach (var tutorial in classTutorials)
                {
                    studentTutorials = await studentTutorialService.GetStudentTutorialByTutorialIdAsync(tutorial.TutorialId);
                    if (studentTutorials == null)
                    {
                        // Add the missing StudentTutorial.
                        var newStudentTutorial = new StudentTutorial { TutorialId = tutorial.TutorialId };
                        await studentTutorialService.CreateStudentTutorialAsync(newStudentTutorial);

                        // Get the newly created StudentTutorial.
                        studentTutorials = await studentTutorialService.GetStudentTutorialByTutorialIdAsync(tutorial.TutorialId);
                    };

                    var progress = studentTutorials.FirstOrDefault();

                    int nextLesson = progress.CompletedLessons + 1;
                    if (nextLesson > tutorial.LessonCount)
                    {
                        nextLesson = tutorial.LessonCount;
                    }

                    var newStudentProgress = new StudentProgress
                        {
                            TutorialId = tutorial.TutorialId,
                            Title = tutorial.Tutorial!.Title!,
                            NextLesson = nextLesson,
                            PercentageDone = ((progress!.CompletedLessons * 100) / tutorial.LessonCount),
                            QuizGrade = progress.QuizScore
                        };
                    studentProgresses.Add(newStudentProgress);
                }
            }


        ShowData = true;
    }
    catch (Exception ex)
    {
        ErrorMessages["Message"] = ex.Message;
        ShowErrorMsg = true;
    }
}

    public class StudentProgress
    {
        public int TutorialId { get; set; }
        public string? Title { get; set; }
        public int NextLesson { get; set; }
        public int PercentageDone { get; set; }
        public int? QuizGrade { get; set; }
        public string? Action { get; set; }
    }
}
