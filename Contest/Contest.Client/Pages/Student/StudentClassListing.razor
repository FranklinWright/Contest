@page "/student/classlisting"

@using Contest.Client.Services
@rendermode InteractiveWebAssembly
@inject NavigationManager navManager


<PageTitle>Class Listing</PageTitle>
<header />

<h1>
    Classes
    <a href="classadd"><button class="btn btn-success"><i class="bi bi-plus-circle"></i></button></a>
</h1>

@if (!showClasses)
{
    <p><em>Loading...</em></p>
}
else
{
    @if (classes.Count == 0)
    {
        <p><em>No classes found.</em></p>
    }
    else
    {
        <p><em>You have joined @classes.Count classes.</em></p>

        <ul>
            @foreach (var item in classes)
            {
                <div class="pb-2">
                    <a class="btn btn-primary" href="/student/class/@item.ClassId"><i class="bi bi-eye"></i></a>
                    <span class="b-2 ps-1"> @item.ClassName</span>
                </div>
            }
        </ul>
    }
}

@code {
    private bool showClasses = false;
    private List<ClassUserResponse>? classes;

    protected override async Task OnInitializedAsync()
    {
        var service = new ClassUserService(navManager);
        classes = await service.GetClassUserAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            showClasses = true;
        }
    }
}
