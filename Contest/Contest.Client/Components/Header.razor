<AuthorizeView>
     <div class="alert alert-info">
    @if (context.User.IsInRole("Admin"))
    {
            <span>Admin: </span>  
    }
    else if (context.User.IsInRole("Teacher"))
    {
            <span>Teacher: </span>
        }
    else if (context.User.IsInRole("Student"))
    {
            <span>Student: </span>
        }

    @context.User.Claims.FirstOrDefault(c => c.Type == "FirstName")?.Value
    @context.User.Claims.FirstOrDefault(c => c.Type == "LastName")?.Value
    </div>
</AuthorizeView>
